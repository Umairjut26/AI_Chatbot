# ─────────────────────────────────────────────
# AI Portfolio Chatbot — Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to Git.

# Your Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# Model to use (gemini-flash-latest is recommended for this key)
MODEL_NAME=gemini-flash-latest

# Allowed origins for CORS — comma-separated
# Use * to allow all, or restrict to your portfolio domain in production
# Example: http://localhost,https://umairdev.online
ALLOWED_ORIGINS=*
